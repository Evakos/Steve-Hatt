# WooCommerce REST API (wc/v3) — the fresh WordPress+WooCommerce instance, not the live
# stevehattfishmongers.co.uk site. See the master plan, Phase A/B for provisioning/migration.
WOOCOMMERCE_URL=https://example-headless-backend.example
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cardstream/Pay360 — sandbox base URL is https://api.mite.pay360.com, production is
# https://api.pay360.com. Real integration blocked on Pay360 developer portal access (the
# Hosted Payment Fields token flow specifically — see master plan, Phase D). Their docs
# (docs.pay360.com, public, no portal access needed) are otherwise readable and confirm a free
# self-service "Explorer account" for MITE sandbox credentials. Set CARDSTREAM_MOCK=true (and
# NEXT_PUBLIC_CARDSTREAM_MOCK=true) to exercise the checkout flow against
# src/lib/cardstream/mock-client.ts in the meantime.
#
# Checkout only authorises (holds funds) at /api/checkout — fish is priced by weight, so the
# exact final amount isn't known until the order is prepared. Authorisations expire 7 days after
# creation (Pay360 default). Staff capture the confirmed final amount via /admin/orders
# (src/app/api/admin/capture) before that window closes, which is what actually charges the card.
#
# Confirmed against Pay360's docs: Capture always takes the FULL authorised amount — there's no
# partial capture. Since the final weighed price is usually less than the hold, the flow is
# capture-in-full-then-refund-the-difference (partial refunds are supported), not "capture the
# final amount" directly.
CARDSTREAM_API_BASE_URL=https://api.mite.pay360.com
CARDSTREAM_API_USERNAME=
CARDSTREAM_API_PASSWORD=
CARDSTREAM_INSTALLATION_ID=
CARDSTREAM_WEBHOOK_SECRET=
CARDSTREAM_MOCK=true

# Protects /api/cron/reauthorise-preorders — Vercel Cron sends this as `Authorization: Bearer
# <value>` automatically for scheduled invocations (see vercel.json), so this only needs setting
# as a Vercel env var, not called manually. Any long random string.
#
# Christmas pre-orders can be placed from 1st November for delivery on the 23rd/24th December —
# far longer than a Pay360 authorisation survives (7 days, see above). So checkout only verifies
# the card at order time (no hold, no expiry clock — src/lib/cardstream/types.ts VerifyCardResult)
# and stores a reusable merchant token; this cron job spends that token to place the real
# authorisation a few days before each order's delivery slot, so it's always fresh when staff
# capture it. See src/app/api/cron/reauthorise-preorders/route.ts.
CRON_SECRET=

# Public — safe to expose client-side, same role as a Stripe publishable key.
NEXT_PUBLIC_CARDSTREAM_INSTALLATION_ID=
NEXT_PUBLIC_CARDSTREAM_MOCK=true

# Resend — sends the order confirmation email (estimated total, "authorised not charged" wording)
# after /api/checkout and /api/checkout/confirm. Domain must be verified in Resend for the FROM
# address in src/lib/email/send-order-confirmation.ts to actually deliver.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Staff inbox(es) notified of every new order (sendAdminNewOrderNotification), pre-order auth
# failures and contact-form submissions. Comma-separated if more than one — e.g.
# "orders@stevehattfishmongers.co.uk, chris@stevehattfishmongers.co.uk". The domain's mail is
# now hosted on Fastmail (moved off Google Workspace) — unaffected by the Resend DNS records
# above, which are scoped to send.stevehattfishmongers.co.uk specifically so they don't touch
# the root domain's real MX. Reuses orders@ (the same address emails are sent FROM) rather than
# a separate admin@/payment@ inbox — one mailbox for everything order-related.
ADMIN_NOTIFICATION_EMAIL=orders@stevehattfishmongers.co.uk

# /admin area (order capture + product sync) — single shared password, not per-user accounts,
# matching the scale of a single-shop staff team. See src/lib/staff-auth.ts.
STAFF_PASSWORD=
STAFF_SESSION_SECRET=

# /account (customer login) — passwordless magic-link auth, no WordPress login involved. Signs
# both the emailed link token and the session cookie (src/lib/customer-auth.ts). Any long random
# string; not something a person needs to remember or look up.
CUSTOMER_SESSION_SECRET=

# /admin/products — one-way "Google Sheet -> WooCommerce" content sync (src/lib/google-sheets.ts,
# src/app/api/admin/sync-products). Staff edit a shared spreadsheet's "Products" tab (columns:
# product_id, title, price, status, tag, preparation, origin, sustainability, storage, description,
# Christmas price, Christmas deposit
# — see steve-hatt-products.xlsx for the starting layout) and click "Sync now" to push those
# fields into WooCommerce. "status" must be one of draft/pending/private/publish — anything else
# errors that row rather than being sent to WooCommerce. A blank cell in any column leaves that
# field untouched on the product (doesn't clear it), so partially-filled rows are safe.
#
# All three of these are optional — the sync route returns a clear error if unset rather than the
# whole app failing to boot. Setup (one-time, in Google Cloud Console):
#   1. Create/reuse a GCP project, enable the "Google Sheets API".
#   2. IAM & Admin -> Service Accounts -> Create service account (no roles needed) -> Keys ->
#      Add key -> JSON -> download.
#   3. GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL = the key file's "client_email".
#      GOOGLE_SHEETS_PRIVATE_KEY = the key file's "private_key" (keep the \n escapes as-is).
#   4. Create the Google Sheet, add a tab literally named "Products", share it with the service
#      account's email as Viewer.
#   5. GOOGLE_SHEETS_SPREADSHEET_ID = the long ID in the sheet's URL
#      (docs.google.com/spreadsheets/d/<THIS PART>/edit).
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Vercel Edge Config — a small key-value store read at the edge, used for the site-wide
# "Christmas shop" toggle (src/lib/feature-flags.ts) so staff can turn Christmas pre-ordering on
# or off from /admin without a redeploy. `vercel env pull` fills this in automatically once the
# Edge Config store is linked to the project; the connection string embeds its own read token.
EDGE_CONFIG=

# Optional — only needed for the *write* side of the Christmas on/off + seasonal premium controls
# on /admin/guide (src/lib/edge-config-admin.ts). EDGE_CONFIG above is read-only by design, so
# saving those settings needs a separate, more privileged credential:
#   1. VERCEL_API_TOKEN — create at vercel.com/account/tokens, scoped to the team that owns this
#      project. Not narrowly scoped to Edge Config, treat it as a broad account/team credential.
#   2. VERCEL_TEAM_ID — the team's ID (`orgId` in .vercel/project.json once the project is linked).
#   3. EDGE_CONFIG_ID — the Edge Config's own ID (`ecfg_...`, from `vercel edge-config list`).
# Without these, the site still works, /admin/guide's controls just show a save error.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
EDGE_CONFIG_ID=
